# Template for .env — copy to .env and fill in the real values.
#   cp .env.example .env

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__MyCnn=Host=postgres;Port=5432;Database=MathELearning;Username=elearning_user;Password=123
# DATABASE_URL=postgres://elearning_user:123@postgres:5432/MathELearning

APP_BASE_URL=http://localhost

JwtSettings__SecretKey=__CHANGE_ME__at_least_32_characters__
JwtSettings__Issuer=ELearning_ToanHocHay
JwtSettings__Audience=ELearning_ToanHocHay_Users
JwtSettings__ExpirationMinutes=1440

AI__PythonServerUrl=http://ai_core:5001
# Shared secret sent with every request to Flask; must match INTERNAL_API_KEY in AI/.env
AI__InternalApiKey=__CHANGE_ME__shared_ai_secret__

# CORS: one origin per line, increasing index
Cors__AllowedOrigins__0=https://your-webapp-domain

SendGrid__ApiKey=
SendGrid__SenderEmail=
SendGrid__SenderName=E-Learning Team

# SePay — cổng thanh toán QR / IPN.
#   Env / MerchantId / SecretKey: hiện KHÔNG được code đọc (chưa verify chữ ký phía server) — để trống được.
#   BaseUrl BẮT BUỘC là https://qr.sepay.vn (rỗng => link QR hỏng).
#   BankName + VA phải KHỚP tài khoản ngân hàng đã liên kết trên my.sepay.vn.
#   ApiKeyValidator: chuỗi bí mật tự đặt; nhập ĐÚNG chuỗi này (không kèm tiền tố "Apikey ")
#     vào webhook trên SePay, chọn phương thức xác thực = "API Key".
SePay__Env=live
SePay__MerchantId=
SePay__SecretKey=
SePay__BaseUrl=https://qr.sepay.vn
SePay__BankName=TPBank
SePay__VA=
SePay__ApiKeyValidator=__CHANGE_ME__sepay_ipn_secret__
# QR hết hạn sau (phút) — hiển thị đồng hồ đếm ngược ở trang thanh toán.
SePay__QrTimeoutMinutes=15
# Vòng đời subscription (P5):
SePay__AmountToleranceVnd=0
SePay__PendingTimeoutMinutes=30
SePay__LifecycleIntervalMinutes=5
