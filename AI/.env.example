# Template for AI/.env — copy to AI/.env and fill in the real keys.
#   cp AI/.env.example AI/.env

# ---------- Gemini (Google) — provider mặc định ----------
# Lấy key tại https://aistudio.google.com/apikey (định dạng "AIza...").
# Hỗ trợ 1 key hoặc nhiều key xoay vòng: GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# Model dùng cho hint/feedback/chatbot (mặc định: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ---------- OpenAI — KHÔNG còn bắt buộc ----------
# Chỉ cần nếu bạn tự chuyển code trong Main_AI_Service.py / Logic_chatbot.py về OpenAIService.
OPENAI_API_KEY=
# OPENAI_API_KEY_1=
# OPENAI_API_KEY_2=

FLASK_PORT=5001

# Shared secret with the C# backend (X-Internal-Api-Key header). Must match AI__InternalApiKey.
# Leave empty locally to skip the check (dev only).
INTERNAL_API_KEY=
